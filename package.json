{
  "name": "siva-lalitha-nursery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prerender": "react-snap",
    "preview": "vite preview",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"],
    "skipThirdPartyRequests": true,
    "waitFor": 2500,
    "timeout": 60000,
    "minifyHtml": { "minifyCSS": true, "minifyJS": false },
    "inlineCss": false,
    "removeBlobs": false,
    "exclude": ["/404"],
    "include": [
      "/",
      "/about",
      "/plant-nursery-in-kadiyam",
      "/plants",
      "/plants/flower-plants",
      "/plants/fruit-plants",
      "/plants/ornamental-plants",
      "/plants/indoor-plants",
      "/plants/outdoor-plants",
      "/plants/garden-plants",
      "/plants/avenue-plants",
      "/plants/medicinal-plants",
      "/plants/tree-plants",
      "/plants/hedge-plants",
      "/plants/lawn-plants",
      "/plants/bonsai-plants",
      "/plants/rose",
      "/plants/hibiscus",
      "/plants/jasmine",
      "/plants/dasturi",
      "/plants/bougainvillea",
      "/plants/areca-palm",
      "/plants/ficus-bonsai",
      "/plants/ficus-hedge",
      "/plants/rosemary",
      "/plants/mango",
      "/plants/lemon",
      "/plants/guava",
      "/plants/alstonia",
      "/plants/neem",
      "/services",
      "/services/landscaping",
      "/wholesale-plants",
      "/blog",
      "/blog/best-plants-for-home-garden",
      "/blog/top-flowering-plants",
      "/blog/best-fruit-plants",
      "/blog/gardening-tips",
      "/blog/landscaping-ideas",
      "/blog/seasonal-plants",
      "/contact",
      "/faq"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
}
